        const active = i === state.activePane;
        btn.style.color = active ? 'var(--text-primary)' : 'var(--text-dim)';
        if (active) {
          headerTrack.scrollTo({
            left: Math.max(0, btn.offsetLeft - 16),
            behavior: 'smooth'
          });
        }
      });

      // Show active view pane
      for (let i = 0; i < 4; i++) {
        document.getElementById(`pane-${i}`).classList.toggle('hidden', i !== state.activePane);
      }

      // Show sub-tabs only on Collection pivot
      document.getElementById('collectionSubTabs').classList.toggle('hidden', state.activePane !== 0);

      // Hide bottom mini-player when full-screen Now Playing pivot is active
      document.getElementById('miniPlayerBar').classList.toggle('hidden', state.activePane === 1);
    }

    // Horizontal Swipe Support on Mobile Touch Viewport
    let touchStartX = 0;
    let touchStartY = 0;
    const touchViewport = document.getElementById('touchViewport');

    touchViewport.addEventListener('touchstart', e => {
      if (e.target.closest('input[type="range"]')) return;
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });

    touchViewport.addEventListener('touchend', e => {
      if (!touchStartX) return;
      const dx = e.changedTouches[0].screenX - touchStartX;
      const dy = e.changedTouches[0].screenY - touchStartY;
      touchStartX = 0;
      touchStartY = 0;

      // Trigger panorama slide on deliberate horizontal swipe
      if (Math.abs(dx) > 52 && Math.abs(dx) > Math.abs(dy) * 1.4) {
        if (dx < 0 && state.activePane < 3) {
          switchPanorama(state.activePane + 1);
        } else if (dx > 0 && state.activePane > 0) {
          switchPanorama(state.activePane - 1);
        }
      }
    }, { passive: true });

    function toggleTheme() {
      state.darkMode = !state.darkMode;
      document.body.classList.toggle('theme-light', !state.darkMode);
      showToast(state.darkMode ? 'Zune Pitch Black Mode' : 'Zune Crisp Light Mode');
    }

    /*************************************************************************
     * 6. COLLECTION RENDERING (ARTISTS, ALBUMS, SONGS, PLAYLISTS + A-Z JUMP)
     *************************************************************************/
    function setCollectionTab(tab) {
      state.collectionTab = tab;
      document.querySelectorAll('.metro-sub-tab').forEach(btn => {
        const active = btn.dataset.sub === tab;
        btn.style.color = active ? 'var(--zune-pink)' : 'var(--text-secondary)';
      });
      renderCollection();
    }

    function getFilteredLibrary() {
      return state.library.filter(t => {
        const q = state.searchQuery;
        const matchQ = !q ||
          t.title.toLowerCase().includes(q) ||
          t.artist.toLowerCase().includes(q) ||
          t.album.toLowerCase().includes(q);
        const matchArtist = !state.selectedArtist || t.artist === state.selectedArtist;
        const matchAlbum = !state.selectedAlbum || t.album === state.selectedAlbum;
        return matchQ && matchArtist && matchAlbum;
      });
    }

    function renderCollection() {
      const container = document.getElementById('collectionScrollArea');
      const filterBanner = document.getElementById('activeFilterBanner');

      if (state.selectedArtist || state.selectedAlbum) {
        filterBanner.classList.remove('hidden');
        document.getElementById('activeFilterText').textContent = state.selectedAlbum
          ? `album: ${state.selectedAlbum}`
          : `artist: ${state.selectedArtist}`;
      } else {
        filterBanner.classList.add('hidden');
      }

      const items = getFilteredLibrary();

      // TAB 1: ARTISTS WITH WINDOWS PHONE 7 ALPHABETICAL LETTER SQUARES
      if (state.collectionTab === 'artists' && !state.selectedArtist && !state.selectedAlbum) {
        const artistMap = new Map();
        items.forEach(t => {
          if (!artistMap.has(t.artist)) {
            artistMap.set(t.artist, { name: t.artist, count: 0, cover: t.cover });
          }
          artistMap.get(t.artist).count++;
        });

        const sortedArtists = Array.from(artistMap.values()).sort((a, b) => a.name.localeCompare(b.name));
        let lastLetter = '';
        let html = '';

        sortedArtists.forEach(art => {
          const letter = art.name[0].toLowerCase();
          if (letter !== lastLetter) {
            lastLetter = letter;
            html += `
              <button onclick="openAlphaJump()"
                      id="alpha-anchor-${letter}"
                      class="w-10 h-10 mt-3 mb-1.5 flex items-center justify-center text-xl metro-light-title text-white zune-gradient-bg metro-tile">
                ${letter}
              </button>
            `;
          }
          html += `
            <div onclick="filterByArtist('${escapeStr(art.name)}')"
                 class="metro-tile flex items-center gap-3.5 py-2.5 cursor-pointer">
              <img src="${art.cover}" alt="" class="w-12 h-12 object-cover shrink-0 border" style="border-color: var(--border-metro);" />
              <div class="min-w-0 flex-1">
                <div class="metro-light-title text-2xl truncate leading-tight">${art.name}</div>
                <div class="text-xs" style="color: var(--text-secondary);">${art.count} ${art.count === 1 ? 'song' : 'songs'}</div>
              </div>
            </div>
          `;
        });

        container.innerHTML = html || `<div class="py-12 text-center text-sm" style="color: var(--text-secondary);">No matching artists found</div>`;
        return;
      }

      // TAB 2: ALBUMS (SHARP METRO SQUARE GRID)
      if (state.collectionTab === 'albums' && !state.selectedAlbum) {
        const albumMap = new Map();
        items.forEach(t => {
          if (!albumMap.has(t.album)) {
            albumMap.set(t.album, t);
          }
        });
        const albums = Array.from(albumMap.values());

        container.innerHTML = `
          <div class="grid grid-cols-2 gap-3 pt-1">
            ${albums.map(alb => `
              <div onclick="filterByAlbum('${escapeStr(alb.album)}')" class="metro-tile cursor-pointer flex flex-col gap-1.5">
                <div class="relative aspect-square w-full border" style="border-color: var(--border-metro);">
                  <img src="${alb.cover}" alt="${alb.album}" class="w-full h-full object-cover" />
                  <button onclick="event.stopPropagation(); playAlbum('${escapeStr(alb.album)}');"
                          class="absolute bottom-2 right-2 w-9 h-9 text-white zune-gradient-bg flex items-center justify-center shadow-md">
                    ▶
                  </button>
                </div>
                <div class="text-sm font-semibold truncate">${alb.album}</div>
                <div class="text-xs truncate -mt-1" style="color: var(--text-secondary);">${alb.artist}</div>
              </div>
            `).join('')}
          </div>
        `;
        return;
      }

      // TAB 4: PLAYLISTS
      if (state.collectionTab === 'playlists') {
        const lists = state.playlists.length ? state.playlists : [
          { name: 'Zune HD 2009 Essentials', count: DEMO_TRACKS.length, cover: DEMO_TRACKS[4].cover, isDemo: true },
          { name: 'Post-Punk & Indie Favorites', count: state.favorites.size, cover: DEMO_TRACKS[0].cover, isDemo: true }
        ];

        container.innerHTML = `
          <div class="space-y-2.5 pt-1">
            ${lists.map((p, idx) => `
              <div onclick="${p.isDemo ? `startSmartMix(${idx === 1 ? "'favorites'" : "'all'"})` : `playSpotifyPlaylist('${p.uri}')`}"
                   class="metro-tile flex items-center gap-3.5 p-2 border cursor-pointer"
                   style="background-color: var(--bg-tile); border-color: var(--border-metro);">
                <img src="${p.cover}" alt="" class="w-14 h-14 object-cover shrink-0" />
                <div class="min-w-0 flex-1">
                  <div class="metro-light-title text-xl truncate">${p.name}</div>
                  <div class="text-xs" style="color: var(--text-secondary);">${p.count} tracks</div>
                </div>
                <span class="px-2 text-sm" style="color: var(--zune-pink);">▶</span>
              </div>
            `).join('')}
          </div>
        `;
        return;
      }

      // TAB 3: SONGS LIST (OR FILTERED ARTIST/ALBUM TRACKLIST)
      const currentTrack = state.queue[state.currentIndex];
      container.innerHTML = `
        <div class="flex items-center justify-between py-2 mb-1">
          <button onclick="playFilteredList(0)" class="text-xs font-bold uppercase tracking-widest flex items-center gap-1.5" style="color: var(--zune-pink);">
            <span>▶</span> play all (${items.length})
          </button>
        </div>
        <div class="divide-y" style="border-color: var(--border-metro);">
          ${items.map((track, idx) => {
            const active = currentTrack && currentTrack.id === track.id;
            const fav = state.favorites.has(track.id);
            return `
              <div onclick="playFilteredList(${idx})"
                   class="metro-tile py-3 flex items-center justify-between gap-3 cursor-pointer">
                <div class="min-w-0 flex-1">
                  <div class="text-base font-normal truncate" style="color: ${active ? 'var(--zune-pink)' : 'var(--text-primary)'};">
                    ${active && state.isPlaying ? '▶ ' : ''}${track.title}
                  </div>
                  <div class="text-xs truncate" style="color: var(--text-secondary);">
                    ${track.artist} · ${track.album}
                  </div>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <button onclick="event.stopPropagation(); toggleFavoriteId('${track.id}')"
                          class="text-base px-1" style="color: ${fav ? 'var(--zune-pink)' : 'var(--text-dim)'};">
                    ${fav ? '♥' : '♡'}
                  </button>
                  <span class="text-xs font-mono" style="color: var(--text-secondary);">${formatMs(track.durationMs)}</span>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;
    }

    function filterByArtist(artist) {
      state.selectedArtist = artist;
      state.selectedAlbum = null;
      renderCollection();
    }

    function filterByAlbum(album) {
      state.selectedAlbum = album;
      renderCollection();
    }

    function resetCollectionFilters() {
      state.selectedArtist = null;
      state.selectedAlbum = null;
      renderCollection();
    }

    function toggleSearchBar() {
      const box = document.getElementById('mobileSearchBox');
      box.classList.toggle('hidden');
      if (!box.classList.contains('hidden')) {
        document.getElementById('searchInput').focus();
      }
    }

    function handleSearch(val) {
      state.searchQuery = val.trim().toLowerCase();
      renderCollection();
    }

    function clearSearch() {
      state.searchQuery = '';
      document.getElementById('searchInput').value = '';
      document.getElementById('mobileSearchBox').classList.add('hidden');
      renderCollection();
    }

    // Windows Phone 7 / Zune Alphabetical Jump-Grid Overlay
    function openAlphaJump() {
      const availableLetters = new Set(state.library.map(t => t.artist[0].toLowerCase()));
      const alphabet = 'abcdefghijklmnopqrstuvwxyz'.split('');
      document.getElementById('alphaJumpGrid').innerHTML = alphabet.map(ch => {
        const hasItems = availableLetters.has(ch);
        return `
          <button onclick="jumpToLetter('${ch}')" ${hasItems ? '' : 'disabled'}
                  class="aspect-square flex items-center justify-center text-2xl metro-light-title text-white ${hasItems ? 'zune-gradient-bg metro-tile' : 'opacity-20 border border-neutral-800'}">
            ${ch}
          </button>
        `;
      }).join('');
      document.getElementById('alphaJumpOverlay').classList.remove('hidden');
    }

    function closeAlphaJump() {
      document.getElementById('alphaJumpOverlay').classList.add('hidden');
    }

    function jumpToLetter(letter) {
      closeAlphaJump();
      const target = document.getElementById(`alpha-anchor-${letter}`);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    /*************************************************************************
     * 7. SMART DJ / QUICKPLAY LIVE TILES & NOW PLAYING MOSAIC
     *************************************************************************/
    function renderSmartDjHub() {
      document.getElementById('tileTotalSongs').textContent = `${state.library.length} tracks ready`;
      document.getElementById('tileFavCount').textContent = `${state.favorites.size} favorites`;

      const channels = [
        { title: 'post-punk pulse', sub: 'sharp guitars & basslines', color: '#EC008C' },
        { title: 'redmond night', sub: 'ambient oled synthwave', color: '#F26522' },
        { title: '2000s indie', sub: 'classic garage revival', color: '#7C3AED' },
        { title: 'deep focus', sub: 'instrumental rotation', color: '#0D9488' }
      ];

      document.getElementById('smartDjGrid').innerHTML = channels.map(ch => `
        <button onclick="startSmartMix('random')"
                class="metro-tile h-24 p-3 text-left flex flex-col justify-between border"
                style="background-color: var(--bg-tile); border-color: var(--border-metro); border-left: 3px solid ${ch.color};">
          <div class="text-sm font-semibold leading-tight">${ch.title}</div>
          <div class="text-[11px]" style="color: var(--text-secondary);">${ch.sub}</div>
        </button>
      `).join('');

      // Pinned / Recent Albums
      const seenAlbums = new Set();
      const albums = [];
      state.library.forEach(t => {
        if (!seenAlbums.has(t.album) && albums.length < 4) {
          seenAlbums.add(t.album);
          albums.push(t);
        }
      });

      document.getElementById('pinnedAlbumsGrid').innerHTML = albums.map(alb => `
        <div onclick="playAlbum('${escapeStr(alb.album)}'); switchPanorama(1);"
             class="metro-tile relative aspect-square overflow-hidden cursor-pointer border"
             style="border-color: var(--border-metro);">
          <img src="${alb.cover}" alt="" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent p-2.5 flex flex-col justify-end">
            <div class="text-white text-xs font-semibold truncate">${alb.album}</div>
            <div class="text-white/75 text-[10px] truncate">${alb.artist}</div>
          </div>
        </div>
      `).join('');
    }

    function renderNowPlayingMosaic() {
      const grid = document.getElementById('npMosaicGrid');
      const covers = state.library.map(t => t.cover);
      if (!covers.length) return;
      let html = '';
      for (let i = 0; i < 12; i++) {
        html += `<img src="${covers[i % covers.length]}" alt="" class="w-full aspect-square object-cover" />`;
      }
      grid.innerHTML = html;
    }

    function toggleMosaicMode() {
      state.mosaicMode = !state.mosaicMode;
      document.getElementById('npMosaicGrid').classList.toggle('hidden', !state.mosaicMode);
      document.getElementById('npBackdropImg').classList.toggle('hidden', state.mosaicMode);
      document.getElementById('mosaicModeBtn').textContent = state.mosaicMode ? 'wallpaper: mosaic' : 'wallpaper: cover';
    }

    function openQueueDrawer() {
      const current = state.queue[state.currentIndex];
      document.getElementById('queueDrawerList').innerHTML = state.queue.map((t, i) => {
        const active = current && current.id === t.id;
        return `
          <div onclick="playQueueIndex(${i}); closeQueueDrawer();"
               class="py-3 flex items-center gap-3 cursor-pointer">
            <img src="${t.cover}" alt="" class="w-11 h-11 object-cover shrink-0" />
            <div class="min-w-0 flex-1">
              <div class="text-sm font-medium truncate" style="color: ${active ? 'var(--zune-pink)' : 'var(--text-primary)'};">
                ${active ? '▶ ' : ''}${t.title}
              </div>
              <div class="text-xs truncate" style="color: var(--text-secondary);">${t.artist}</div>
            </div>
            <span class="text-xs font-mono" style="color: var(--text-secondary);">${formatMs(t.durationMs)}</span>
          </div>
        `;
      }).join('');
      document.getElementById('queueDrawer').classList.remove('translate-y-full');
    }

    function closeQueueDrawer() {
      document.getElementById('queueDrawer').classList.add('translate-y-full');
    }

    function renderAll() {
      renderCollection();
      renderSmartDjHub();
      renderNowPlayingMosaic();
    }

    /*************************************************************************
     * 8. PLAYBACK TRANSPORT & SEEK ENGINE
     *************************************************************************/
    function loadTrack(autoPlay = true) {
      const track = state.queue[state.currentIndex];
      if (!track) return;

      state.positionMs = 0;
      state.durationMs = track.durationMs || 180000;

      // Update Mini Player
      document.getElementById('miniCover').src = track.cover;
      document.getElementById('miniTitle').textContent = track.title;
      document.getElementById('miniArtist').textContent = track.artist;

      // Update Full-Screen Now Playing
      document.getElementById('npBackdropImg').src = track.cover;
      document.getElementById('npMainCover').src = track.cover;
      document.getElementById('npArtistText').textContent = track.artist.toLowerCase();
      document.getElementById('npSongText').textContent = track.title;
      document.getElementById('npAlbumText').textContent = `${track.album} · ${track.year}`;
      document.getElementById('npQueueCount').textContent = state.queue.length;

      updateHeartUI();
      updateSeekUI();

      if (autoPlay) {
        state.isPlaying = true;
        if (state.spotifyConnected) {
          triggerSpotifyPlayback(track);
        } else {
          demoSynth.play(track);
        }
      }

      updatePlayIcons();
      renderCollection();
    }

    function togglePlayPause() {
      const track = state.queue[state.currentIndex];
      if (!track) return;

      state.isPlaying = !state.isPlaying;
      if (state.isPlaying) {
        if (state.spotifyConnected) {
          if (state.spotifyPlayer) state.spotifyPlayer.resume();
          else triggerSpotifyPlayback(track);
        } else {
          demoSynth.play(track);
        }
      } else {
        if (state.spotifyConnected && state.spotifyPlayer) {
          state.spotifyPlayer.pause();
        } else {
          demoSynth.stop();
        }
      }
      updatePlayIcons();
      renderCollection();
    }

    function nextTrack() {
      if (!state.queue.length) return;
      state.currentIndex = state.shuffle
        ? Math.floor(Math.random() * state.queue.length)
        : (state.currentIndex + 1) % state.queue.length;
      loadTrack(true);
    }

    function prevTrack() {
      if (!state.queue.length) return;
      if (state.positionMs > 3500) {
        state.positionMs = 0;
        updateSeekUI();
        return;
      }
      state.currentIndex = (state.currentIndex - 1 + state.queue.length) % state.queue.length;
      loadTrack(true);
    }

    function playQueueIndex(idx) {
      state.currentIndex = idx;
      loadTrack(true);
    }

    function playFilteredList(idx) {
      const list = getFilteredLibrary();
      if (!list.length) return;
      state.queue = [...list];
      state.currentIndex = idx;
      loadTrack(true);
    }

    function playAlbum(albumName) {
      const tracks = state.library.filter(t => t.album === albumName);
      if (!tracks.length) return;
      state.queue = [...tracks];
      state.currentIndex = 0;
      loadTrack(true);
    }

    function playShuffledAll() {
      state.queue = [...state.library].sort(() => Math.random() - 0.5);
      state.currentIndex = 0;
      loadTrack(true);
      switchPanorama(1);
      showToast('Shuffling all music');
    }

    function startSmartMix(mode) {
      let pool = [...state.library];
      if (mode === 'favorites' && state.favorites.size > 0) {
        pool = state.library.filter(t => state.favorites.has(t.id));
      } else {
        pool.sort(() => Math.random() - 0.5);
      }
      state.queue = pool;
      state.currentIndex = 0;
      loadTrack(true);
      switchPanorama(1);
      showToast('Smart DJ Mix started');
    }

    async function playSpotifyPlaylist(uri) {
      if (!state.spotifyToken || !uri) return;
      try {
        await fetch('https://api.spotify.com/v1/me/player/play', {
          method: 'PUT',
          headers: {
            Authorization: `Bearer ${state.spotifyToken}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ context_uri: uri })
        });
        switchPanorama(1);
        showToast('Playing Spotify playlist');
      } catch (e) {
        showToast('Open Spotify on a device to start playlist');
      }
    }

    function toggleShuffle() {
      state.shuffle = !state.shuffle;
      const btn = document.getElementById('shuffleBtn');
      btn.style.borderColor = state.shuffle ? 'var(--zune-pink)' : 'var(--border-metro)';
      btn.style.color = state.shuffle ? 'var(--zune-pink)' : 'var(--text-secondary)';
      showToast(state.shuffle ? 'Shuffle: On' : 'Shuffle: Off');
    }

    function toggleRepeat() {
      state.repeat = !state.repeat;
      const btn = document.getElementById('repeatBtn');
      btn.style.borderColor = state.repeat ? 'var(--zune-pink)' : 'var(--border-metro)';
      btn.style.color = state.repeat ? 'var(--zune-pink)' : 'var(--text-secondary)';
      showToast(state.repeat ? 'Repeat: On' : 'Repeat: Off');
    }

    function toggleFavoriteCurrent() {
      const track = state.queue[state.currentIndex];
      if (track) toggleFavoriteId(track.id);
    }

    function toggleFavoriteId(id) {
      if (state.favorites.has(id)) {
        state.favorites.delete(id);
      } else {
        state.favorites.add(id);
      }
      updateHeartUI();
      renderCollection();
      renderSmartDjHub();
    }

    function updateHeartUI() {
      const track = state.queue[state.currentIndex];
      const fav = track && state.favorites.has(track.id);
      const btn = document.getElementById('npFavoriteBtn');
      btn.textContent = fav ? '♥' : '♡';
      btn.style.color = fav ? 'var(--zune-pink)' : 'var(--text-primary)';
      btn.style.borderColor = fav ? 'var(--zune-pink)' : 'var(--border-metro)';
    }

    function handleVolumeChange(val) {
      state.volume = Number(val) / 100;
      document.getElementById('volumePctLabel').textContent = `${val}%`;
      demoSynth.setVolume(state.volume);
      if (state.spotifyPlayer) state.spotifyPlayer.setVolume(state.volume);
    }

    function handleScrubInput(val) {
      state.isScrubbing = true;
      state.positionMs = Math.floor((Number(val) / 1000) * state.durationMs);
      updateSeekUI();
    }

    function handleScrubCommit(val) {
      state.isScrubbing = false;
      state.positionMs = Math.floor((Number(val) / 1000) * state.durationMs);
      if (state.spotifyConnected && state.spotifyPlayer) {
        state.spotifyPlayer.seek(state.positionMs);
      }
      updateSeekUI();
    }

    function updatePlayIcons() {
      document.getElementById('npPlayIcon').classList.toggle('hidden', state.isPlaying);
      document.getElementById('npPauseIcon').classList.toggle('hidden', !state.isPlaying);
      document.getElementById('miniPlayIcon').classList.toggle('hidden', state.isPlaying);
      document.getElementById('miniPauseIcon').classList.toggle('hidden', !state.isPlaying);
    }

    function updateSeekUI() {
      const pct = state.durationMs > 0 ? Math.min(100, (state.positionMs / state.durationMs) * 100) : 0;
      if (!state.isScrubbing) {
        document.getElementById('npSeekSlider').value = Math.round(pct * 10);
      }
      document.getElementById('npSeekFill').style.width = `${pct}%`;
      document.getElementById('miniProgressLine').style.width = `${pct}%`;
      document.getElementById('npElapsed').textContent = formatMs(state.positionMs);
      document.getElementById('npRemaining').textContent = `-${formatMs(Math.max(0, state.durationMs - state.positionMs))}`;
    }

    setInterval(() => {
      if (state.isPlaying && !state.isScrubbing) {
        state.positionMs += 250;
        if (state.positionMs >= state.durationMs) {
          if (state.repeat) {
            state.positionMs = 0;
          } else {
            nextTrack();
          }
        }
        updateSeekUI();
      }
    }, 250);

    /*************************************************************************
     * 9. UTILITIES & BOOTSTRAP
     *************************************************************************/
    function copyRedirectUri() {
      const field = document.getElementById('redirectUriInput');
      field.select();
      document.execCommand('copy');
      const btn = document.getElementById('copyUriBtn');
      btn.textContent = 'copied';
      setTimeout(() => (btn.textContent = 'copy'), 1800);
    }

    function formatMs(ms) {
      const total = Math.floor((ms || 0) / 1000);
      const m = Math.floor(total / 60);
      const s = total % 60;
      return `${m}:${s < 10 ? '0' : ''}${s}`;
    }

    function escapeStr(s) {
      return String(s).replace(/'/g, "\\'");
    }

    let toastTimer = null;
    function showToast(msg) {
      const el = document.getElementById('zuneToast');
      el.textContent = msg;
      el.classList.remove('opacity-0');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.add('opacity-0'), 2400);
    }

    window.addEventListener('DOMContentLoaded', async () => {
      document.getElementById('redirectUriInput').value = getRedirectUri();
      const savedCid = localStorage.getItem('zune_mobile_spotify_cid');
      if (savedCid) document.getElementById('clientIdInput').value = savedCid;

      setCollectionTab('artists');
