<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Zune HD — Music + Videos Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Open-source metric-compatible fallback for Segoe UI on non-Windows mobile devices -->
  <link rel="stylesheet" href="https://fontlibrary.org//face/selawik" type="text/css"/>
  <!-- Spotify Web Playback SDK -->
  <script src="https://sdk.scdn.co/spotify-player.js"></script>

  <style>
    :root {
      --font-zune: 'Segoe UI', 'Selawik', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-zune-light: 'Segoe UI Light', 'Segoe UI', 'Selawik Light', 'Selawik', -apple-system, BlinkMacSystemFont, sans-serif;
      --bg-pitch: #000000;
      --bg-surface: #0D0D0D;
      --bg-tile: #141414;
      --bg-tile-hover: #1E1E1E;
      --text-primary: #FFFFFF;
      --text-secondary: #8E8E93;
      --text-dim: #48484A;
      --border-metro: #242426;
      --zune-pink: #EC008C;
      --zune-orange: #F26522;
      --zune-gradient: linear-gradient(135deg, #EC008C 0%, #F26522 100%);
      --scrim-gradient: linear-gradient(180deg, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0.72) 55%, rgba(0,0,0,0.96) 100%);
    }

    body.theme-light {
      --bg-pitch: #FFFFFF;
      --bg-surface: #F5F5F5;
      --bg-tile: #EBEBEB;
      --bg-tile-hover: #E0E0E0;
      --text-primary: #000000;
      --text-secondary: #5E5E62;
      --text-dim: #A0A0A5;
      --border-metro: #DCDCE0;
      --scrim-gradient: linear-gradient(180deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.82) 55%, rgba(255,255,255,0.97) 100%);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      font-family: var(--font-zune);
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background-color: #070707;
      color: var(--text-primary);
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Mobile Device Frame on Desktop, Full-Bleed on Mobile */
    #mobileShell {
      width: 100%;
      height: 100dvh;
      max-width: 440px;
      margin: 0 auto;
      background-color: var(--bg-pitch);
      color: var(--text-primary);
      position: relative;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    @media (min-width: 520px) {
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 50% 30%, #191118 0%, #050505 100%);
      }
      #mobileShell {
        height: min(880px, 95dvh);
        border: 1px solid #262629;
        box-shadow: 0 32px 80px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(236, 0, 140, 0.14);
      }
    }

    /* Authentic Zune HD / Metro Typography */
    .metro-hub-kicker {
      font-family: var(--font-zune);
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .metro-pivot-header {
      font-family: var(--font-zune-light);
      font-weight: 200;
      font-size: 46px;
      line-height: 0.96;
      letter-spacing: -0.04em;
      text-transform: lowercase;
      white-space: nowrap;
      transition: color 0.24s cubic-bezier(0.16, 1, 0.3, 1), transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .metro-sub-tab {
      font-family: var(--font-zune);
      font-weight: 600;
      font-size: 13px;
      letter-spacing: 0.03em;
      text-transform: lowercase;
      transition: color 0.15s ease;
    }

    .metro-light-title {
      font-family: var(--font-zune-light);
      font-weight: 200;
      letter-spacing: -0.03em;
    }

    /* Kinetic Metro Tile Press Physics (Sharp 0px corners) */
    .metro-tile {
      border-radius: 0px;
      transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.16s ease;
    }
    .metro-tile:active {
      transform: perspective(600px) rotateX(2deg) scale(0.965);
    }

    /* Hide Scrollbars cleanly for touch panning */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Zune Gradient Accents */
    .zune-gradient-bg {
      background: var(--zune-gradient);
    }
    .zune-gradient-text {
      background: var(--zune-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Zune HD Now Playing Panning Backdrop Animation */
    @keyframes zuneSlowPan {
      0% { transform: scale(1.16) translate3d(0%, 0%, 0); }
      33% { transform: scale(1.24) translate3d(-4%, -3%, 0); }
      66% { transform: scale(1.20) translate3d(3%, -4%, 0); }
      100% { transform: scale(1.16) translate3d(0%, 0%, 0); }
    }
    .zune-pan-backdrop {
      animation: zuneSlowPan 26s ease-in-out infinite;
    }

    /* Metro Range Slider (Sharp Zune Seek Bar) */
    input[type="range"].zune-seek {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
      height: 22px;
    }
    input[type="range"].zune-seek::-webkit-slider-runnable-track {
      height: 3px;
      background: rgba(142, 142, 147, 0.32);
    }
    input[type="range"].zune-seek::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 12px;
      height: 12px;
      border-radius: 0px;
      background: var(--text-primary);
      border: 2px solid var(--zune-pink);
      margin-top: -4.5px;
    }

    /* Slide-Up Queue Drawer Transition */
    #queueDrawer {
      transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }
  </style>
</head>
<body>

  <!-- MOBILE ZUNE HD / METRO SHELL -->
  <div id="mobileShell">

    <!-- TOP STATUS & ZUNE HUB KICKER BAR -->
    <header class="pt-3 px-4 pb-1 z-20 shrink-0" style="background-color: var(--bg-pitch);">
      <div class="flex items-center justify-between mb-1.5">
        <div class="flex items-center gap-2">
          <!-- Zune Emblem -->
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <path d="M4 4H20L12 12L20 20H4L12 12L4 4Z" stroke="url(#zuneMobileGrad)" stroke-width="2.5" stroke-linejoin="round"/>
            <defs>
              <linearGradient id="zuneMobileGrad" x1="4" y1="4" x2="20" y2="20" gradientUnits="userSpaceOnUse">
                <stop stop-color="#EC008C"/>
                <stop offset="1" stop-color="#F26522"/>
              </linearGradient>
            </defs>
          </svg>
          <span class="metro-hub-kicker" style="color: var(--text-primary);">music + videos</span>
        </div>

        <!-- Right Quick Status Actions -->
        <div class="flex items-center gap-2">
          <button id="audioModeBadge" onclick="switchPanorama(3)"
                  class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 border"
                  style="border-color: var(--border-metro); color: var(--zune-pink);">
            demo synth
          </button>
          <button onclick="toggleTheme()" title="Toggle Pitch Black / Crisp Light"
                  class="w-6 h-6 flex items-center justify-center border text-[11px]"
                  style="border-color: var(--border-metro); color: var(--text-secondary);">
            ◐
          </button>
        </div>
      </div>

      <!-- CLIPPED HORIZONTAL PANORAMA / PIVOT HEADERS (Swipeable & Tappable) -->
      <div id="panoramaHeaderTrack" class="flex items-baseline gap-6 overflow-x-auto no-scrollbar py-1">
        <button onclick="switchPanorama(0)" data-idx="0" class="metro-pivot-header shrink-0">collection</button>
        <button onclick="switchPanorama(1)" data-idx="1" class="metro-pivot-header shrink-0">now playing</button>
        <button onclick="switchPanorama(2)" data-idx="2" class="metro-pivot-header shrink-0">smart dj</button>
        <button onclick="switchPanorama(3)" data-idx="3" class="metro-pivot-header shrink-0 pr-16">spotify</button>
      </div>

      <!-- CONTEXTUAL SUB-PIVOTS (Visible for Collection) -->
      <div id="collectionSubTabs" class="flex items-center justify-between pt-2 pb-1.5 border-b" style="border-color: var(--border-metro);">
        <div class="flex items-center gap-5">
          <button onclick="setCollectionTab('artists')" data-sub="artists" class="metro-sub-tab">artists</button>
          <button onclick="setCollectionTab('albums')" data-sub="albums" class="metro-sub-tab">albums</button>
          <button onclick="setCollectionTab('songs')" data-sub="songs" class="metro-sub-tab">songs</button>
          <button onclick="setCollectionTab('playlists')" data-sub="playlists" class="metro-sub-tab">playlists</button>
        </div>
        <button onclick="toggleSearchBar()" class="p-1" style="color: var(--text-secondary);" title="Search">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>
          </svg>
        </button>
      </div>

      <!-- Collapsible Metro Search Input -->
      <div id="mobileSearchBox" class="hidden pt-2 pb-1">
        <div class="flex items-center gap-2">
          <input id="searchInput" type="text" placeholder="filter artists, albums, songs..."
                 oninput="handleSearch(this.value)"
                 class="w-full text-sm px-3 py-2 border outline-none"
                 style="background-color: var(--bg-tile); border-color: var(--zune-pink); color: var(--text-primary); border-radius: 0px;" />
          <button onclick="clearSearch()" class="px-3 py-2 text-xs font-bold uppercase border"
                  style="border-color: var(--border-metro); color: var(--text-secondary);">✕</button>
        </div>
      </div>
    </header>

    <!-- MAIN SWIPEABLE PANORAMA VIEWPORT -->
    <main id="touchViewport" class="flex-1 w-full relative overflow-hidden">

      <!-- ============================================================ -->
      <!-- PIVOT 0: COLLECTION (Metro Lists + Alphabet Jump Squares)    -->
      <!-- ============================================================ -->
      <section id="pane-0" class="w-full h-full flex flex-col overflow-hidden">
        <!-- Active Filter Pill if Artist or Album selected -->
        <div id="activeFilterBanner" class="hidden px-4 py-2 flex items-center justify-between text-xs border-b"
             style="background-color: var(--bg-surface); border-color: var(--border-metro);">
          <span id="activeFilterText" class="font-semibold truncate" style="color: var(--zune-pink);"></span>
          <button onclick="resetCollectionFilters()" class="uppercase text-[10px] font-bold tracking-wider px-2 py-0.5 border"
                  style="border-color: var(--border-metro);">show all</button>
        </div>

        <!-- Scrollable Collection List / Grid -->
        <div id="collectionScrollArea" class="flex-1 overflow-y-auto no-scrollbar px-4 pt-2 pb-24">
          <!-- Populated dynamically based on sub-tab -->
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- PIVOT 1: NOW PLAYING (Full-Screen Mobile Zune HD Canvas)     -->
      <!-- ============================================================ -->
      <section id="pane-1" class="hidden w-full h-full relative overflow-hidden flex flex-col justify-between">
        <!-- Live Panning / Drifting Album Art Wallpaper -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
          <img id="npBackdropImg" src="" alt="" class="w-full h-full object-cover opacity-45 zune-pan-backdrop" />
          <!-- Optional Mosaic Overlay Mode -->
          <div id="npMosaicGrid" class="hidden absolute inset-0 grid grid-cols-3 gap-1 opacity-35"></div>
          <div class="absolute inset-0" style="background: var(--scrim-gradient);"></div>
        </div>

        <!-- Top Now Playing Controls (Mosaic toggle & Up Next Queue trigger) -->
        <div class="relative z-10 px-4 pt-2 flex items-center justify-between">
          <button onclick="toggleMosaicMode()" id="mosaicModeBtn"
                  class="text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 border backdrop-blur-sm"
                  style="border-color: var(--border-metro); color: var(--text-secondary);">
            wallpaper: cover
          </button>

          <button onclick="openQueueDrawer()"
                  class="text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 border backdrop-blur-sm flex items-center gap-1.5"
                  style="border-color: var(--border-metro); color: var(--text-primary);">
            <span>up next</span>
            <span id="npQueueCount" class="px-1.5 py-0.2 text-white zune-gradient-bg">0</span>
          </button>
        </div>

        <!-- Center Crisp Square Album Artwork -->
        <div class="relative z-10 px-6 my-auto flex flex-col items-center">
          <div class="relative w-56 h-56 sm:w-64 sm:h-64 shadow-2xl border" style="border-color: rgba(255,255,255,0.14);">
            <img id="npMainCover" src="" alt="Album Cover" class="w-full h-full object-cover" />
            <!-- Zune Signature Accent Bar -->
            <div class="h-1 w-full zune-gradient-bg"></div>
          </div>
        </div>

        <!-- Bottom Metadata, Seek Bar & Circular Metro Transport Controls -->
        <div class="relative z-10 px-5 pb-5 pt-2 flex flex-col gap-3">
          <!-- Artist & Track Typography + Heart -->
          <div class="flex items-end justify-between gap-3">
            <div class="min-w-0 flex-1">
              <div id="npArtistText" class="metro-light-title text-3xl sm:text-4xl truncate leading-tight" style="color: var(--text-primary);">
                artist name
              </div>
              <div id="npSongText" class="text-base font-semibold truncate mt-0.5 zune-gradient-text">
                song title
              </div>
              <div id="npAlbumText" class="text-xs uppercase tracking-wider truncate mt-0.5" style="color: var(--text-secondary);">
                album · year
              </div>
            </div>

            <!-- Heart / Favorite Square Button -->
            <button onclick="toggleFavoriteCurrent()" id="npFavoriteBtn"
                    class="w-11 h-11 shrink-0 border flex items-center justify-center text-xl metro-tile"
                    style="border-color: var(--border-metro); background-color: var(--bg-tile);">
              ♡
            </button>
          </div>

          <!-- Interactive Seek Bar with Elapsed & Remaining Time -->
          <div class="flex flex-col gap-0.5">
            <div class="relative w-full flex items-center">
              <input id="npSeekSlider" type="range" min="0" max="1000" value="0"
                     oninput="handleScrubInput(this.value)"
                     onchange="handleScrubCommit(this.value)"
                     class="zune-seek w-full z-10" />
              <div id="npSeekFill" class="absolute left-0 h-[3px] pointer-events-none zune-gradient-bg" style="width: 0%;"></div>
            </div>
            <div class="flex justify-between text-[11px] font-mono" style="color: var(--text-secondary);">
              <span id="npElapsed">0:00</span>
              <span id="npRemaining">-0:00</span>
            </div>
          </div>

          <!-- Authentic Zune Circular Outline Transport Buttons -->
          <div class="flex items-center justify-between px-1 pt-1">
            <!-- Shuffle -->
            <button id="shuffleBtn" onclick="toggleShuffle()" title="Shuffle"
                    class="w-9 h-9 rounded-full border flex items-center justify-center transition-colors"
                    style="border-color: var(--border-metro); color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/>
                <polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/>
              </svg>
            </button>

            <!-- Previous -->
            <button onclick="prevTrack()" title="Previous"
                    class="w-12 h-12 rounded-full border-2 flex items-center justify-center active:scale-90 transition-transform"
                    style="border-color: var(--text-primary); color: var(--text-primary);">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
              </svg>
            </button>

            <!-- Play / Pause (Hero Circular Button) -->
            <button onclick="togglePlayPause()" title="Play / Pause"
                    class="w-16 h-16 rounded-full border-2 flex items-center justify-center active:scale-95 transition-transform shadow-lg"
                    style="border-color: var(--text-primary); color: var(--text-primary);">
              <svg id="npPlayIcon" class="w-7 h-7 ml-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <svg id="npPauseIcon" class="w-7 h-7 hidden" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
              </svg>
            </button>

            <!-- Next -->
            <button onclick="nextTrack()" title="Next"
                    class="w-12 h-12 rounded-full border-2 flex items-center justify-center active:scale-90 transition-transform"
                    style="border-color: var(--text-primary); color: var(--text-primary);">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
              </svg>
            </button>

            <!-- Repeat -->
            <button id="repeatBtn" onclick="toggleRepeat()" title="Repeat"
                    class="w-9 h-9 rounded-full border flex items-center justify-center transition-colors"
                    style="border-color: var(--border-metro); color: var(--text-secondary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                <polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>
              </svg>
            </button>
          </div>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- PIVOT 2: SMART DJ / QUICKPLAY (Metro Live-Tile Grid)         -->
      <!-- ============================================================ -->
      <section id="pane-2" class="hidden w-full h-full overflow-y-auto no-scrollbar px-4 pt-2 pb-24">
        <!-- Quick Action Hero Live Tiles -->
        <div class="grid grid-cols-2 gap-2.5 mb-5">
          <button onclick="playShuffledAll()"
                  class="metro-tile h-28 p-3.5 text-left flex flex-col justify-between text-white zune-gradient-bg">
            <span class="text-[10px] font-bold uppercase tracking-widest opacity-85">instant mix</span>
            <div>
              <div class="metro-light-title text-2xl leading-none">shuffle all</div>
              <div class="text-[11px] opacity-85 mt-1" id="tileTotalSongs">10 tracks ready</div>
            </div>
          </button>

          <button onclick="startSmartMix('favorites')"
                  class="metro-tile h-28 p-3.5 text-left flex flex-col justify-between border"
                  style="background-color: var(--bg-tile); border-color: var(--border-metro);">
            <span class="text-[10px] font-bold uppercase tracking-widest" style="color: var(--zune-pink);">smart dj</span>
            <div>
              <div class="metro-light-title text-2xl leading-none">hearted</div>
              <div class="text-[11px] mt-1" style="color: var(--text-secondary);" id="tileFavCount">3 favorites</div>
            </div>
          </button>
        </div>

        <!-- Smart DJ Curated Channels -->
        <div class="text-[11px] font-bold uppercase tracking-widest mb-2" style="color: var(--text-secondary);">
          smart dj channels
        </div>
        <div class="grid grid-cols-2 gap-2.5 mb-5" id="smartDjGrid">
          <!-- Populated dynamically -->
        </div>

        <!-- Pinned / Recent Albums Live Tiles -->
        <div class="text-[11px] font-bold uppercase tracking-widest mb-2" style="color: var(--text-secondary);">
          pinned & recent rotation
        </div>
        <div class="grid grid-cols-2 gap-2.5" id="pinnedAlbumsGrid">
          <!-- Populated dynamically -->
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- PIVOT 3: SPOTIFY SYNC HUB (Serverless PKCE OAuth + SDK)      -->
      <!-- ============================================================ -->
      <section id="pane-3" class="hidden w-full h-full overflow-y-auto no-scrollbar px-4 pt-2 pb-24">
        <div class="flex flex-col gap-4">
          <!-- Status Card -->
          <div class="p-4 border" style="background-color: var(--bg-tile); border-color: var(--border-metro);">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 text-white zune-gradient-bg">
                zune + spotify bridge
              </span>
              <span id="spotifyConnPill" class="text-[11px] font-semibold" style="color: var(--text-secondary);">
                ● demo mode
              </span>
            </div>
            <h2 class="metro-light-title text-2xl mt-2" id="spotifyHubHeading">Sync Your Spotify Library</h2>
            <p class="text-xs mt-1 leading-relaxed" style="color: var(--text-secondary);" id="spotifyHubSub">
              Connect your Spotify account via serverless PKCE OAuth to import your Saved Tracks, Albums, and Playlists into the Zune HD interface.
            </p>

            <button id="spotifyDisconnectBtn" onclick="disconnectSpotify()"
                    class="hidden mt-3 px-3 py-1.5 text-xs font-bold uppercase tracking-wider border border-red-500/40 text-red-400">
              disconnect spotify
            </button>
          </div>

          <!-- Redirect URI Box -->
          <div class="p-4 border space-y-2" style="background-color: var(--bg-tile); border-color: var(--border-metro);">
            <div class="text-[11px] font-bold uppercase tracking-wider" style="color: var(--zune-orange);">
              1. Spotify Developer Redirect URI
            </div>
            <p class="text-[11px]" style="color: var(--text-secondary);">
              Add this exact URL in your <a href="https://developer.spotify.com/dashboard" target="_blank" class="underline" style="color: var(--text-primary);">Spotify Dashboard</a> app settings:
            </p>
            <div class="flex items-center gap-1.5">
              <input id="redirectUriInput" type="text" readonly
                     class="flex-1 text-[11px] font-mono px-2.5 py-2 border outline-none"
                     style="background-color: var(--bg-pitch); border-color: var(--border-metro); color: var(--text-primary);" />
              <button onclick="copyRedirectUri()" id="copyUriBtn"
                      class="px-3 py-2 text-[11px] font-bold uppercase text-white zune-gradient-bg shrink-0">
                copy
              </button>
            </div>
          </div>

          <!-- Client ID & Connect Action -->
          <div class="p-4 border space-y-3" style="background-color: var(--bg-tile); border-color: var(--border-metro);">
            <div class="text-[11px] font-bold uppercase tracking-wider" style="color: var(--zune-pink);">
              2. Authorize Spotify Account
            </div>
            <div>
              <label for="clientIdInput" class="block text-xs mb-1" style="color: var(--text-secondary);">Spotify App Client ID</label>
              <input id="clientIdInput" type="text" placeholder="Paste your 32-char Client ID..."
                     class="w-full text-xs font-mono px-3 py-2.5 border outline-none focus:border-[#EC008C]"
                     style="background-color: var(--bg-pitch); border-color: var(--border-metro); color: var(--text-primary);" />
            </div>

            <button onclick="initiateSpotifyPKCE()"
                    class="w-full py-3 text-xs font-bold uppercase tracking-widest text-white zune-gradient-bg metro-tile">
              connect spotify account →
            </button>
          </div>

          <!-- Volume Control for Mobile Web Audio / SDK -->
