    /*************************************************************************
     * 3. WEB AUDIO API POLYPHONIC SYNTHESIZER (INSTANT DEMO ENGINE)
     *************************************************************************/
    class ZuneMobileSynth {
      constructor() {
        this.ctx = null;
        this.masterGain = null;
        this.timer = null;
        this.step = 0;
      }

      ensureContext() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioCtx();
          this.masterGain = this.ctx.createGain();
          this.masterGain.gain.value = state.volume * 0.24;
          this.masterGain.connect(this.ctx.destination);
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      setVolume(vol) {
        if (this.masterGain && this.ctx) {
          this.masterGain.gain.setTargetAtTime(vol * 0.24, this.ctx.currentTime, 0.04);
        }
      }

      play(track) {
        this.stop();
        this.ensureContext();
        const cfg = track.synth || { root: 220, scale: [0, 3, 7, 10, 12], tempo: 115, wave: 'triangle' };
        const intervalMs = (60 / cfg.tempo / 2) * 1000;

        const triggerNote = () => {
          if (!state.isPlaying || state.spotifyConnected) return;
          const now = this.ctx.currentTime;
          const semi = cfg.scale[this.step % cfg.scale.length];
          const oct = this.step % 8 === 0 ? 0.5 : (this.step % 4 === 2 ? 2 : 1);
          const freq = cfg.root * Math.pow(2, semi / 12) * oct;

          const osc = this.ctx.createOscillator();
          const env = this.ctx.createGain();
          osc.type = cfg.wave;
          osc.frequency.setValueAtTime(freq, now);

          env.gain.setValueAtTime(0.001, now);
          env.gain.exponentialRampToValueAtTime(0.32, now + 0.035);
          env.gain.exponentialRampToValueAtTime(0.0008, now + (intervalMs / 1000) * 1.75);

          osc.connect(env);
          env.connect(this.masterGain);
          osc.start(now);
          osc.stop(now + (intervalMs / 1000) * 1.85);
          this.step++;
        };

        triggerNote();
        this.timer = setInterval(triggerNote, intervalMs);
      }

      stop() {
        if (this.timer) {
          clearInterval(this.timer);
          this.timer = null;
        }
      }
    }

    const demoSynth = new ZuneMobileSynth();

    /*************************************************************************
     * 4. SPOTIFY SERVERLESS PKCE OAUTH & WEB PLAYBACK SDK
     *************************************************************************/
    function getRedirectUri() {
      return window.location.origin + window.location.pathname;
    }

    function randomVerifier(len = 64) {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
      const arr = crypto.getRandomValues(new Uint8Array(len));
      return Array.from(arr, x => chars[x % chars.length]).join('');
    }

    async function sha256Challenge(verifier) {
      const data = new TextEncoder().encode(verifier);
      const digest = await crypto.subtle.digest('SHA-256', data);
      return btoa(String.fromCharCode(...new Uint8Array(digest)))
        .replace(/=/g, '')
        .replace(/\+/g, '-')
        .replace(/\//g, '_');
    }

    async function initiateSpotifyPKCE() {
      const clientId = document.getElementById('clientIdInput').value.trim();
      if (!clientId) {
        showToast('Enter your Spotify App Client ID first');
        return;
      }

      localStorage.setItem('zune_mobile_spotify_cid', clientId);
      const verifier = randomVerifier(64);
      localStorage.setItem('zune_mobile_spotify_verifier', verifier);
      const challenge = await sha256Challenge(verifier);

      const scopes = [
        'streaming',
        'user-read-email',
        'user-read-private',
        'user-library-read',
        'user-library-modify',
        'user-top-read',
        'playlist-read-private',
        'user-read-playback-state',
        'user-modify-playback-state'
      ].join(' ');

      const url = new URL('https://accounts.spotify.com/authorize');
      url.search = new URLSearchParams({
        response_type: 'code',
        client_id: clientId,
        scope: scopes,
        code_challenge_method: 'S256',
        code_challenge: challenge,
        redirect_uri: getRedirectUri()
      }).toString();

      window.location.href = url.toString();
    }

    async function checkSpotifyOAuthCallback() {
      const params = new URLSearchParams(window.location.search);
      const code = params.get('code');
      const err = params.get('error');

      if (err) {
        showToast('Spotify auth cancelled: ' + err);
        window.history.replaceState({}, document.title, getRedirectUri());
        return;
      }

      if (code) {
        const clientId = localStorage.getItem('zune_mobile_spotify_cid');
        const verifier = localStorage.getItem('zune_mobile_spotify_verifier');
        window.history.replaceState({}, document.title, getRedirectUri());
        if (!clientId || !verifier) return;

        try {
          showToast('Connecting to Spotify...');
          const res = await fetch('https://accounts.spotify.com/api/token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
              client_id: clientId,
              grant_type: 'authorization_code',
              code,
              redirect_uri: getRedirectUri(),
              code_verifier: verifier
            })
          });
          const tokenData = await res.json();
          if (tokenData.access_token) {
            localStorage.setItem('zune_mobile_spotify_token', tokenData.access_token);
            localStorage.setItem('zune_mobile_spotify_exp', Date.now() + tokenData.expires_in * 1000);
            await hydrateSpotifySession(tokenData.access_token);
          } else {
            showToast('Spotify auth failed: ' + (tokenData.error_description || 'Invalid token'));
          }
        } catch (e) {
          console.error(e);
          showToast('Network error during Spotify handshake');
        }
      } else {
        const saved = localStorage.getItem('zune_mobile_spotify_token');
        const exp = Number(localStorage.getItem('zune_mobile_spotify_exp') || 0);
        if (saved && Date.now() < exp) {
          await hydrateSpotifySession(saved);
        }
      }
    }

    async function hydrateSpotifySession(token) {
      state.spotifyToken = token;
      state.spotifyConnected = true;
      demoSynth.stop();

      try {
        const meRes = await fetch('https://api.spotify.com/v1/me', {
          headers: { Authorization: `Bearer ${token}` }
        });
        if (!meRes.ok) throw new Error('Spotify session expired');
        state.spotifyUser = await meRes.json();

        document.getElementById('audioModeBadge').textContent = 'spotify live';
        document.getElementById('audioModeBadge').style.color = '#1DB954';
        document.getElementById('spotifyConnPill').textContent = `● ${state.spotifyUser.display_name || 'connected'}`;
        document.getElementById('spotifyConnPill').style.color = '#1DB954';
        document.getElementById('spotifyHubHeading').textContent = `Synced: ${state.spotifyUser.display_name}`;
        document.getElementById('spotifyHubSub').textContent = 'Your Spotify Saved Tracks, Albums, and Playlists are loaded into your Zune HD collection.';
        document.getElementById('spotifyDisconnectBtn').classList.remove('hidden');

        await syncSpotifyLibraryData(token);
        setupSpotifyWebPlayback(token);
        showToast(`Synced Spotify library for ${state.spotifyUser.display_name}`);
      } catch (e) {
        disconnectSpotify(true);
      }
    }

    async function syncSpotifyLibraryData(token) {
      const headers = { Authorization: `Bearer ${token}` };
      const [tracksRes, playlistsRes] = await Promise.all([
        fetch('https://api.spotify.com/v1/me/tracks?limit=50', { headers }),
        fetch('https://api.spotify.com/v1/me/playlists?limit=25', { headers })
      ]);

      const tracksJson = await tracksRes.json();
      const playlistsJson = await playlistsRes.json();

      if (tracksJson.items && tracksJson.items.length) {
        const mapped = tracksJson.items
          .filter(x => x.track)
          .map(x => {
            const t = x.track;
            return {
              id: t.id,
              uri: t.uri,
              title: t.name,
              artist: t.artists.map(a => a.name).join(', '),
              album: t.album.name,
              year: (t.album.release_date || '').slice(0, 4) || 'Spotify',
              durationMs: t.duration_ms,
              cover: (t.album.images && t.album.images[0]) ? t.album.images[0].url : DEMO_TRACKS[0].cover
            };
          });
        state.library = mapped;
        state.queue = [...mapped];
        state.currentIndex = 0;
      }

      if (playlistsJson.items) {
        state.playlists = playlistsJson.items.map(p => ({
          id: p.id,
          uri: p.uri,
          name: p.name,
          count: p.tracks.total,
          cover: (p.images && p.images[0]) ? p.images[0].url : DEMO_TRACKS[0].cover
        }));
      }

      renderAll();
      loadTrack(false);
    }

    function setupSpotifyWebPlayback(token) {
      if (!window.Spotify) return;
      const player = new window.Spotify.Player({
        name: 'Zune HD Mobile Web Hub',
        getOAuthToken: cb => cb(token),
        volume: state.volume
      });

      player.addListener('ready', ({ device_id }) => {
        state.spotifyDeviceId = device_id;
        showToast('Spotify Web Playback SDK Active');
      });

      player.addListener('player_state_changed', s => {
        if (!s) return;
        state.isPlaying = !s.paused;
        state.positionMs = s.position;
        state.durationMs = s.duration;
        updatePlayIcons();
      });

      player.connect();
      state.spotifyPlayer = player;
    }

    async function triggerSpotifyPlayback(track) {
      if (!state.spotifyToken || !track.uri) return;
      const url = state.spotifyDeviceId
        ? `https://api.spotify.com/v1/me/player/play?device_id=${state.spotifyDeviceId}`
        : `https://api.spotify.com/v1/me/player/play`;
      try {
        await fetch(url, {
          method: 'PUT',
          headers: {
            Authorization: `Bearer ${state.spotifyToken}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ uris: [track.uri] })
        });
      } catch (e) {
        console.warn('Spotify playback API error:', e);
      }
    }

    function disconnectSpotify(silent = false) {
      localStorage.removeItem('zune_mobile_spotify_token');
      localStorage.removeItem('zune_mobile_spotify_exp');
      if (state.spotifyPlayer) state.spotifyPlayer.disconnect();

      state.spotifyConnected = false;
      state.spotifyToken = null;
      state.spotifyUser = null;
      state.library = [...DEMO_TRACKS];
      state.queue = [...DEMO_TRACKS];
      state.currentIndex = 0;

      document.getElementById('audioModeBadge').textContent = 'demo synth';
      document.getElementById('audioModeBadge').style.color = 'var(--zune-pink)';
      document.getElementById('spotifyConnPill').textContent = '● demo mode';
      document.getElementById('spotifyConnPill').style.color = 'var(--text-secondary)';
      document.getElementById('spotifyHubHeading').textContent = 'Sync Your Spotify Library';
      document.getElementById('spotifyDisconnectBtn').classList.add('hidden');

      renderAll();
      loadTrack(false);
      if (!silent) showToast('Disconnected Spotify · Demo Library restored');
    }

